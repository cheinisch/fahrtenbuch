# Pflichtwerte
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fahrtenbuch
POSTGRES_USER=fahrtenbuch
POSTGRES_PASSWORD=change-me

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=fahrtenbuch
JWT_AUDIENCE=fahrtenbuch-app

# Öffentliche Serveradresse für den QR-Code
PUBLIC_BASE_URL=https://fahrtenbuch.example.de

# TOTP / Passkeys
# Eigenen Schlüssel verwenden; ohne Angabe wird JWT_ACCESS_SECRET verwendet.
TOTP_ENCRYPTION_KEY=replace-with-another-long-random-secret
TOTP_ISSUER=Fahrtenbuch
RP_NAME=Fahrtenbuch
RP_ID=fahrtenbuch.example.de
RP_ORIGIN=https://fahrtenbuch.example.de

# Default-Admin
DEFAULT_ADMIN_EMAIL=admin@example.de
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_DISPLAYNAME=Administrator
DEFAULT_ADMIN_PASSWORD=change-me-now
FORCE_ADMIN_PASSWORD_CHANGE=true

# Passwort-Reset
PASSWORD_RESET_RETURN_LINK=https://fahrtenbuch.example.de/password-reset
PASSWORD_RESET_EXPIRES_MINUTES=30
# Optionaler HTTP-Webhook, der {email, token, resetUrl, expiresAt} erhält.
PASSWORD_RESET_WEBHOOK_URL=

# Kartendienste – Startwerte; danach auch über die Admin-API änderbar
MAP_PROVIDER=osm
MAP_TYPE=raster
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
MAP_MIN_ZOOM=0
MAP_MAX_ZOOM=19
MAP_TILE_SIZE=256

PHOTON_PROVIDER=public
PHOTON_URL=https://photon.komoot.io
PHOTON_TIMEOUT_MS=10000

OVERPASS_PROVIDER=public
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=30000
OVERPASS_RADIUS_METERS=2500
OVERPASS_MAX_RESULTS=50

# Betrieb
APP_ENV=production
APP_VERSION=1.0.0-dev
PORT=3000
TRUST_PROXY=true
DEBUG=false
CORS_ORIGIN=
STATIC_DIR=/app/frontend/dist
MIGRATIONS_DIR=/app/database/migrations
BACKUP_DIR=/data/backups
UPLOAD_LIMIT_BYTES=26214400
TZ=Europe/Berlin
