# ==================================================================
# Fahrtenbuch
# Eine zentrale Konfiguration für Docker Compose und Anwendung.
# ==================================================================

# ------------------------------------------------------------------
# Allgemein
# ------------------------------------------------------------------
APP_NAME=Fahrtenbuch
APP_ENV=production
APP_DEBUG=false
DEBUG=false
TZ=Europe/Berlin
LOG_LEVEL=info

# ------------------------------------------------------------------
# Docker
# Das Image wird vom Workflow als ghcr.io/cheinisch/fahrtenbuch gebaut.
# Für Entwicklungsstände bleibt der Tag "dev".
# ------------------------------------------------------------------
IMAGE_TAG=dev
WEB_PORT=8080

# ------------------------------------------------------------------
# Öffentliche URL
# APP_HOST ohne Protokoll und ohne Pfad angeben.
# ------------------------------------------------------------------
APP_HOST=fahrt.example.de
APP_PROTOCOL=https
CORS_ORIGIN=https://fahrt.example.de

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fahrtenbuch
POSTGRES_USER=fahrtenbuch
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# ------------------------------------------------------------------
# Initialer Administrator
# Wird nur angelegt, wenn noch kein Benutzer mit dieser E-Mail existiert.
# ------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@example.de
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_DISPLAYNAME=Administrator
DEFAULT_ADMIN_PASSWORD=change-me-now
FORCE_ADMIN_PASSWORD_CHANGE=true

# ------------------------------------------------------------------
# Authentifizierung
# ------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=90

# ------------------------------------------------------------------
# Swagger / OpenAPI
# Nur aktiv, wenn DEBUG=true und SWAGGER_ENABLED=true gesetzt sind.
# ------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/v1/docs

# ------------------------------------------------------------------
# Karten und Geodienste
# Interne Photon-/Overpass-Adressen werden nur serverseitig verwendet.
# ------------------------------------------------------------------
MAP_PROVIDER=maplibre
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=https://overpass-api.de/api

# ------------------------------------------------------------------
# Passwort zurücksetzen / SMTP
# PASSWORD_RESET_RETURN_LINK darf in Produktion nicht true sein.
# ------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fahrtenbuch@example.de
PASSWORD_RESET_RETURN_LINK=false

# ------------------------------------------------------------------
# Passkeys / WebAuthn
# ------------------------------------------------------------------
WEBAUTHN_RP_ID=fahrt.example.de
WEBAUTHN_RP_NAME=Fahrtenbuch
WEBAUTHN_ORIGIN=https://fahrt.example.de
