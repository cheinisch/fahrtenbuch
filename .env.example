############################################################
# Allgemein
############################################################

APP_NAME=Fahrtenbuch
APP_ENV=production
NODE_ENV=production
APP_DEBUG=false
APP_VERSION=dev

TZ=Europe/Berlin

############################################################
# Webserver / öffentliche URL
############################################################

APP_HOST=0.0.0.0
APP_PORT=3000
APP_PROTOCOL=https

PUBLIC_BASE_URL=https://fahrtenbuch.example.de

STATIC_DIR=/app/frontend/dist
MIGRATIONS_DIR=/app/backend/src/database/migrations

############################################################
# Docker / GHCR
############################################################

GHCR_OWNER=cheinisch
GHCR_IMAGE_NAME=fahrtenbuch
IMAGE_TAG=dev

############################################################
# Datenbank
############################################################

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fahrtenbuch
POSTGRES_USER=fahrtenbuch
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_SSL=false

############################################################
# JWT / Sitzungen
############################################################

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ACCESS_TOKEN_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

JWT_ISSUER=fahrtenbuch
JWT_AUDIENCE=fahrtenbuch-app

############################################################
# TOTP
############################################################

TOTP_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
TOTP_ISSUER=Fahrtenbuch

############################################################
# Passkeys / WebAuthn
############################################################

WEBAUTHN_RP_NAME=Fahrtenbuch
WEBAUTHN_RP_ID=fahrtenbuch.example.de
WEBAUTHN_ORIGIN=https://fahrtenbuch.example.de

############################################################
# Passwort zurücksetzen
############################################################

PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_URL=https://fahrtenbuch.example.de/password-reset

# Optional:
# PASSWORD_RESET_WEBHOOK_URL=https://automation.example.de/fahrtenbuch/password-reset

############################################################
# Default Administrator
############################################################

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_DISPLAY_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
FORCE_ADMIN_PASSWORD_CHANGE=true

############################################################
# Import / Upload
############################################################

# 200 MiB
UPLOAD_LIMIT_BYTES=209715200

############################################################
# Backups
############################################################

BACKUP_DIR=/data/backups

############################################################
# Karten
############################################################

MAP_PROVIDER=osm
MAP_TYPE=raster
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_MIN_ZOOM=0
MAP_MAX_ZOOM=19
MAP_TILE_SIZE=256

# Nur für Vektorkarten:
# MAP_STYLE_URL=https://example.de/style.json

############################################################
# Photon
############################################################

PHOTON_PROVIDER=public
PHOTON_URL=https://photon.komoot.io
PHOTON_TIMEOUT_MS=10000

############################################################
# Overpass
############################################################

OVERPASS_PROVIDER=public
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=30000
OVERPASS_RADIUS_METERS=2500
OVERPASS_MAX_RESULTS=50

############################################################
# CORS
############################################################

CORS_ORIGIN=https://fahrtenbuch.example.de

############################################################
# Reverse Proxy
############################################################

TRUST_PROXY=true
# Optional: OSM-Tile-Cache (Standard: 10 GiB)
# OSM_TILE_CACHE_MAX_BYTES=10737418240
