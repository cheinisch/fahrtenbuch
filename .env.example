# Fahrtenbuch environment configuration
# Copy this file to .env and replace all CHANGE_ME values before deployment.

# Deployment
IMAGE_TAG=latest
TZ=Europe/Berlin
APP_PORT=3000
# Optional: bind the web application to a specific network interface.
# APP_BIND_IP=0.0.0.0

# Public HTTPS address (no trailing slash)
PUBLIC_BASE_URL=https://fahrtenbuch.example.de
CORS_ORIGIN=https://fahrtenbuch.example.de
TRUST_PROXY=true

# Profile pictures from Gravatar (hashed e-mail is sent to gravatar.com).
# Set to false to disable Gravatar for all users of this instance.
# GRAVATAR_ENABLED=true

# Android app passkeys: the official app from Google Play is allowed out of the box
# (/.well-known/assetlinks.json + app origin). The file must be publicly reachable at
# https://<WEBAUTHN_RP_ID>/.well-known/assetlinks.json.
# ANDROID_OFFICIAL_APP_ENABLED=true
# Additional SHA-256 certificate fingerprints for the app package, comma-separated
# (e.g. self-built debug APKs); package defaults to app.fahrtenbuch.mobile.
# ANDROID_APP_CERT_SHA256=
# ANDROID_APP_PACKAGE=app.fahrtenbuch.mobile
# Other apps (forks), "package=FP|FP; package2=FP":
# ANDROID_EXTRA_APPS=

# Database
POSTGRES_DB=fahrtenbuch
POSTGRES_USER=fahrtenbuch
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Authentication and encryption
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ACCESS_TOKEN_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET

# Initial administrator account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Sign-in methods. false disables setup and use server-wide; stored
# TOTP secrets and passkeys are kept and work again when re-enabled.
# TOTP_ENABLED=true
# PASSKEYS_ENABLED=true

# Passkeys / WebAuthn: use your public HTTPS hostname
WEBAUTHN_RP_ID=fahrtenbuch.example.de
WEBAUTHN_ORIGIN=https://fahrtenbuch.example.de

# Optional: sign-in with a linked Google or Microsoft account.
# A provider is enabled when client ID and secret are set. Redirect URI to
# register with the provider: <PUBLIC_BASE_URL>/api/v1/auth/oauth/<google|microsoft>/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# common | organizations | consumers | <tenant id>
# MICROSOFT_OAUTH_TENANT=common
# Allowed redirect URIs of the mobile app after sign-in (comma-separated).
# OAUTH_APP_REDIRECT_URIS=fahrtenbuch://oauth/callback

# Optional API documentation (disabled by default)
SHOW_API_UI=false

# Optional: password-reset notification webhook
# PASSWORD_RESET_WEBHOOK_URL=https://automation.example.de/password-reset

# Optional: SMTP for outgoing messages
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Optional: Redis Insight binds to localhost by default, because it has no
# login of its own: anyone who reaches it can read and delete all Redis data.
# REDIS_INSIGHT_BIND_IP=127.0.0.1
# REDIS_INSIGHT_PORT=5540
# Address admins use to open Redis Insight (shown as a link under
# Administration > Background jobs), e.g. behind a reverse proxy with auth.
# Without it the link points to http://localhost:5540 (SSH tunnel).
# REDIS_INSIGHT_URL=https://redis.example.de

# Optional: maximum OpenStreetMap tile cache size (default: 10 GiB).
# OSM_TILE_CACHE_MAX_BYTES=10737418240
